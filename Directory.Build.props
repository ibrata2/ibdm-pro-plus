<Project>
  <!-- Shared by every IBDM Pro project. The engine (IbdmPro.Core) is plain net10.0 so it also builds and is tested on Linux;
       the app (IbdmPro.App) targets Windows. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Company>IBRAPROGRAM — ابراهيم الخزرجي</Company>
    <Product>IBDM Pro</Product>
    <Copyright>برمجة و تطوير ابراهيم الخزرجي</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
